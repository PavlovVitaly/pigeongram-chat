{
  "dashboard": {
    "title": "PigeonGram Monitoring",
    "description": "Полный мониторинг мессенджера PigeonGram",
    "timezone": "browser",
    "panels": [
      {
        "title": "🕊️ PigeonGram - Общая статистика",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "title": "Пользователи онлайн",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_connections_active",
            "legendFormat": "Активные"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "title": "Всего сообщений",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_messages_total",
            "legendFormat": "Сообщений"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "title": "Загружено файлов",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_files_uploaded_total",
            "legendFormat": "Файлов"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "purple", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "title": "Размер файлов",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_files_size_bytes_total",
            "legendFormat": "Размер"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "orange", "value": null}
              ]
            },
            "unit": "bytes"
          }
        }
      },
      {
        "title": "Всего пользователей",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_total_users",
            "legendFormat": "Пользователей"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "title": "Всего сообщений в БД",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_total_messages",
            "legendFormat": "Сообщений"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "title": "📈 Активность в реальном времени",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
      },
      {
        "title": "Активные соединения",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_connections_active",
            "legendFormat": "Активные"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "auto"
            }
          }
        }
      },
      {
        "title": "Сообщения в секунду",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(pigeongram_messages_total[1m])",
            "legendFormat": "Сообщений/с"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "cps",
            "min": 0,
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "auto"
            }
          }
        }
      },
      {
        "title": "📊 HTTP запросы",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
      },
      {
        "title": "HTTP запросы по эндпоинтам",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(pigeongram_http_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Время ответа HTTP (95-й перцентиль)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(pigeongram_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "HTTP ошибки (5xx)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(pigeongram_http_requests_total{status=~\"5..\"}[5m]))",
            "legendFormat": "Ошибки 5xx"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 0.1},
                {"color": "red", "value": 0.5}
              ]
            },
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Процент успешных запросов",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(pigeongram_http_requests_total{status!~\"5..\"}[5m])) / sum(rate(pigeongram_http_requests_total[5m])) * 100",
            "legendFormat": "Успешно"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 90},
                {"color": "green", "value": 99}
              ]
            }
          }
        }
      },
      {
        "title": "🗄️ База данных и кэш",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}
      },
      {
        "title": "Операции с БД по типам",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(pigeongram_database_operations_total[5m])",
            "legendFormat": "{{ operation }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Время ответа БД",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(pigeongram_database_duration_seconds_sum[5m]) / rate(pigeongram_database_duration_seconds_count[5m])",
            "legendFormat": "Среднее"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Кэш: hit/miss ratio",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(pigeongram_cache_operations_total{result=\"hit\"}[5m])",
            "legendFormat": "Hit"
          },
          {
            "expr": "rate(pigeongram_cache_operations_total{result=\"miss\"}[5m])",
            "legendFormat": "Miss"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Эффективность кэша",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(pigeongram_cache_operations_total{result=\"hit\"}[5m])) / sum(rate(pigeongram_cache_operations_total[5m])) * 100",
            "legendFormat": "Hit ratio"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        }
      },
      {
        "title": "⚙️ Системные ресурсы",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 48}
      },
      {
        "title": "CPU контейнеров",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\"pigeongram_.*\"}[1m])",
            "legendFormat": "{{ name }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Память контейнеров",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\"pigeongram_.*\"}",
            "legendFormat": "{{ name }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Сетевая активность контейнеров",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\"pigeongram_.*\"}[1m])",
            "legendFormat": "RX - {{ name }}"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{name=~\"pigeongram_.*\"}[1m])",
            "legendFormat": "TX - {{ name }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 57},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "Дисковая активность",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(container_fs_writes_bytes_total{name=~\"pigeongram_.*\"}[1m])",
            "legendFormat": "Write - {{ name }}"
          },
          {
            "expr": "rate(container_fs_reads_bytes_total{name=~\"pigeongram_.*\"}[1m])",
            "legendFormat": "Read - {{ name }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 57},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "title": "⚠️ Ошибки и предупреждения",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 65}
      },
      {
        "title": "Ошибки WebSocket",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pigeongram_websocket_errors_total",
            "legendFormat": "Ошибок"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 66},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 10},
                {"color": "red", "value": 50}
              ]
            },
            "unit": "none"
          }
        }
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d",
        "30d"
      ]
    },
    "tags": ["pigeongram", "monitoring"],
    "version": 1
  }
}